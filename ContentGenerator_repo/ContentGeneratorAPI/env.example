# Configuración de ejemplo. Copia este archivo a .env y completa los valores privados.
# No subas tu archivo .env real al repositorio.

API_URL=http://localhost:8000

# === JWT ===
JWT_ALGORITHM=HS256
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# === Cifrado (para /crypto) ===
ENCRYPTION_KEY=REPLACE_WITH_VALID_FERNET_KEY

# === Bloqueo de inicio de sesión ===
LOGIN_MAX_ATTEMPTS=4
LOGIN_BLOCK_TIME_MINUTES=1

# === Límites de intentos de inicio de sesión ===
RATE_IP_MAX=10
RATE_IP_WINDOW=60
RATE_USER_MAX=10
RATE_USER_WINDOW=60

# === Azure OpenAI ===
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_KEY=REPLACE_WITH_AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# === MongoDB ===
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=YOUR_CLUSTER
MONGODB_DB=marketing_ai
MONGODB_OPENAI_COLLECTION=content_history
MONGODB_USERS_COLLECTION=users
MONGODB_LOGIN_ATTEMPS_COLLECTION=login_attemps
MONGODB_REFRESH_TOKENS_COLLECTION=refresh_tokens
MONGODB_RATE_LIMITS_COLLECTION=rate_limits

# === Email ===
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
EMAIL_FROM=your-email@example.com

# === Cookies/CSRF ===
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
